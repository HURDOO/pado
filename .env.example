# Local rehearsal is the default. Never put real values in this example.
PADO_PORT=4173
PADO_BIND_HOST=127.0.0.1
PADO_ORIGIN=http://127.0.0.1:4173
# At least 16 characters. Admin mode is disabled when unset.
PADO_ADMIN_PASSWORD=
# rehearsal | antigravity (requires a separately authenticated Docker runner)
PADO_RUNNER=rehearsal
PADO_AGENT_IMAGE=pado-agent:local
# Four authenticated app preview origins; defaults to PADO_PORT + 100 through +103.
# PADO_PREVIEW_BASE_PORT=4273
# Public Mac/Tunnel deployment uses an additional private override env file.
# Do not enable public traffic until docs/PUBLIC_DEPLOY.md checks pass.
# PADO_PUBLIC_MODE=1
# Trusted hackathon opt-in: native TUI for the current speaker/turn owner.
# This does not disable Docker/network hardening. Public default is prompt-only.
# PADO_PARTICIPANT_TUI=1
# Trusted hackathon opt-in: allow real subagent delegation and messaging.
# PADO_PUBLIC_SUBAGENTS=1
# Explicit demo-only exception to the 16-character admin password minimum.
# PADO_DEMO_SHORT_ADMIN_PASSWORD=1
# PADO_TRUST_CLOUDFLARE=1
